# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=europe-west4

# Server
PORT=8080

# Logging
LOG_LEVEL=INFO

# Document Processing Limits
MAX_DOCUMENT_SIZE_MB=50
PROCESSING_TIMEOUT_SECONDS=300

# GCS Support
# The service account needs roles/storage.objectViewer on GCS buckets
# used for document storage. No additional env vars needed — uses
# Application Default Credentials.
